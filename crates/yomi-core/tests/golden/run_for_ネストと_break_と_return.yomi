label start {
  for i in range(1, 4) {
    for j in range(1, 4) {
      if j == 3 {
        continue
      }
      if i == 3 {
        break
      }
      ${i}-${j}
    }
  }
  let r = call sum_until(10)
  結果 ${r}
  let names = ["案内人", "門番"]
  for n in names {
    for k in range(0, 2) {
      ${n}${k}
    }
  }
  for m in range(0, 2) {
    ${m}回目
  }
}

label sum_until(limit: int) -> int {
  let total = 0
  for v in range(0, 100) {
    total += v
    if total > limit {
      return total
    }
  }
  return -1
}
