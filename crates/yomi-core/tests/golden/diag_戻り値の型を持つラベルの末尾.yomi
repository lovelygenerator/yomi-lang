label b(x: int) -> int {
  if x > 0 {
    return 1
  }
}

label c(x: int) -> int {
  if x > 0 {
    return 1
  } else {
    return 2
  }
}

label d(x: int) -> int {
  if x > 0 {
    return 1
  } else if x < 0 {
    return 2
  }
}

