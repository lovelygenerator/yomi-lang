save var total: int = 0

label start {
  let i = 0
  while i < 3 {
    i += 1
    ${i} 回目
    total += i
  }
  合計 ${total}
  let j = 0
  while true {
    j += 1
    if j == 2 {
      continue
    }
    if j > 4 {
      break
    }
    j は ${j}
  }
  let a = 0
  while a < 2 {
    a += 1
    let b = 0
    while b < 3 {
      b += 1
      if b == 2 {
        continue
      }
      if a == 2 && b == 3 {
        break
      }
      ${a}-${b}
    }
  }
  条件が最初から偽 
  while false {
    ここは出ない
  }
  終わり ${i} ${j} ${a}
}
