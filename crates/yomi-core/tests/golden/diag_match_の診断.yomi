enum Dir { North, South, Item(int) }
struct P { hp: int }

label start {
  let d = Dir.North
  match d {
    North => 1
  }
  match d {
    North => 1
    South => 2
    Item(n) => 3
    _ => 4
  }
  let o: Option<int> = None
  match o {
    Some(n) => 1
  }
  match 3 {
    1 => 1
    1 => 2
    _ => 3
  }
}
