struct P { name: str, hp: int }
enum Dir { N, Go(int) }

fn fact(n: int) -> int {
  if n <= 1 {
    return 1
  }
  return n * fact(n - 1)
}

fn is_even(n: int) -> bool {
  if n == 0 {
    return true
  }
  return is_odd(n - 1)
}

fn is_odd(n: int) -> bool {
  if n == 0 {
    return false
  }
  return is_even(n - 1)
}

fn heal(p: P, by: int) -> P {
  p.hp += by
  return p
}

fn evens(xs: list<int>) -> list<int> {
  let out: list<int> = []
  for x in xs {
    if x % 2 == 0 {
      out.push(x)
    }
  }
  return out
}

fn step(d: Dir) -> int {
  match d {
    N => return 0
    Go(n) => return n
  }
}

fn first_big(xs: list<int>) -> Option<int> {
  for x in xs {
    if x > 10 {
      return Some(x)
    }
  }
  return None
}

label start {
  階乗 ${fact(10)}、偶数 ${is_even(10)} ${is_odd(10)}
  let p = P { name: "案内人", hp: 3 }
  let q = heal(p, 4)
  元 ${p} 後 ${q}
  ${evens([1, 2, 3, 4, 5, 6])}
  ${step(Dir.N)} ${step(Dir.Go(5))}
  ${first_big([1, 20, 30])} ${first_big([])}
}
